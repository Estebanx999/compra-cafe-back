# Copia este archivo como .env y completa los valores.
# .env NO se sube al repositorio (está en .gitignore).
# Lo leen docker-compose, la aplicación y los tests (mvnw test) automáticamente.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Orígenes del frontend permitidos por CORS, separados por coma, sin "/" al final.
# Ej. en desarrollo: http://localhost:5173
CORS_ORIGENES_PERMITIDOS=
